{
  "name": "bilibili-music-player",
  "version": "1.0.1",
  "description": "BiliWave PC desktop music player prototype for Bilibili music discovery.",
  "author": "BiliWave",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/desktopDev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "icons:generate": "node scripts/generateIcons.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "start:desktop": "electron electron/main.cjs",
    "check:providers": "node scripts/checkProviders.mjs",
    "check:desktop-settings": "node scripts/checkDesktopSettings.cjs",
    "check:desktop-playback": "node scripts/checkDesktopPlaybackState.cjs",
    "check:api-port-status": "node scripts/checkApiPortStatus.cjs",
    "check:dev-server-config": "node scripts/checkDevServerConfig.cjs",
    "check:search-resilience": "node scripts/checkSearchResilience.cjs",
    "check:lyrics": "node scripts/checkLyrics.mjs",
    "check:preferences": "node scripts/checkPreferences.mjs",
    "check:queue": "node scripts/checkQueueLogic.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.biliwave.player",
    "productName": "BiliWave",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
